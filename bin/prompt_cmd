#! /bin/bash
history -a; history -c; history -r
printf '\033[36m%s\033[0m\n' "$(date)"
printf '\033[33m%s\033[0m\n' "$PWD"
if [ "$EMACS" != "t" ]; then
    if [ "$JOBD" != "" ]; then
        t="$JOBD"
    else
        t="untitled"
    fi
    tmux rename-window -t${TMUX_PANE} $t > /dev/null 2> /dev/null
else
    printf '\033[36m%s\033[0m\n' "$(date)"
fi
echo `date` >> ~/bin/working
